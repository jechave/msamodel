#!/bin/sh
# Pre-commit gates for msamodel. Three independent checks; each blocks the commit
# and explains why. See the comment above each gate for the incident it guards.
#
# Enabled via:  git config core.hooksPath .githooks
# Bypass once:  git commit --no-verify

blocked=0

# --- Gate 1: vignettes/ require explicit user HTML approval ------------------
# The user previews doc/<name>.html themselves and must approve before any
# vignettes/ change is committed. A passing test run, or the model eyeballing a
# render, do NOT count. This hook makes that mechanical: a commit
# touching vignettes/ is blocked unless VIGNETTE_APPROVED=1 is set, which the
# user sets (or tells the model to set) ONLY after approving the rendered HTML.
#   Approved commit:   VIGNETTE_APPROVED=1 git commit ...
# (Violated 2026-06-18 — committed re-knit vignettes the user never saw.)
if git diff --cached --name-only | grep -q '^vignettes/'; then
  if [ "$VIGNETTE_APPROVED" != "1" ]; then
    blocked=1
    cat >&2 <<'EOF'
✖ Commit blocked: it touches vignettes/ but no user HTML approval is recorded.

  The user previews the rendered HTML and approves it BEFORE vignettes/ is
  committed. "Tests pass", or the model looking at a render, do NOT satisfy this.

  Rebuild the HTML, have the USER open and approve it, then:

      Rscript -e "devtools::build_vignettes()"   # writes doc/<name>.html

      VIGNETTE_APPROVED=1 git commit ...

  Genuine non-vignette-content edit (e.g. fixing this hook)? bypass: git commit --no-verify
EOF
  fi
fi
# --- Gate 2: no new R CMD check suppressions ---------------------------------
# A check finding is information. Silencing one makes check() quiet without
# making anything true, and the quiet is indistinguishable from a clean run.
#
# On 2026-08-07 utils::globalVariables() was found holding 47 names of which only
# 11 corresponded to a real complaint; the rest had accumulated across commits
# titled "fix(check)" and "declare new NSE globals". Nothing was hidden -- the
# commits were honestly named -- but nobody ever asked whether suppressing was
# the right response, and the baseline note count concealed the growth.
#
# This gate blocks a commit that ADDS a suppression construct. It does not care
# about removals. If a suppression is genuinely warranted, the MAINTAINER decides
# and records it by setting the override:
#   SUPPRESSION_APPROVED=1 git commit ...
added_suppressions=$(
  git diff --cached -U0 -- '*.R' '*.Rmd' DESCRIPTION NAMESPACE .Rbuildignore 2>/dev/null \
    | grep '^+' | grep -v '^+++' \
    | grep -nE 'globalVariables|suppressWarnings|suppressMessages|\bna\.rm[[:space:]]*=[[:space:]]*TRUE|@importFrom[[:space:]]+rlang[[:space:]]+\.data' \
    || true
)
if [ -n "$added_suppressions" ] && [ "$SUPPRESSION_APPROVED" != "1" ]; then
  blocked=1
  {
    echo "✖ Commit blocked: it ADDS a construct that can silence a check finding."
    echo
    echo "$added_suppressions" | sed 's/^/    /'
    echo
    cat <<'EOF'
  A check NOTE/WARNING is information about the code. Suppressing it makes
  check() quiet without making anything true -- and a quiet check() is then no
  longer evidence of anything.

  Before committing, answer: is the finding WRONG (the code is correct and the
  checker cannot see it), or is the code worth changing? Say which, out loud, to
  the maintainer. Do not decide alone.

  If the maintainer agrees the suppression is right:

      SUPPRESSION_APPROVED=1 git commit ...

  (Removing a suppression is never blocked. na.rm=TRUE and suppressMessages()
  are matched too: both hide a condition the maintainer may want to see.)
EOF
  } >&2
fi

# --- Gate 3: SPM-generation changes must prove the fixture still reproduces --
# znb_spm / znb_wt are CACHED RESULTS of a seeded recipe. Every test that fits,
# decomposes, or predicts consumes them as INPUT, so a change to the generation
# code that moves a number leaves the cache stale while those tests stay green --
# they never re-derive it. The one check that catches this regenerates all 2280
# rows and compares (test-spm-generate.R, "reproduces the embedded SPM fixture").
#
# That check costs ~21 s, so it is gated behind MSAMODEL_FULL_TESTS=true. Its
# comment used to say it ran at "milestone / CI" -- there is no CI in this repo,
# so in practice it ran only when someone remembered. The commit log shows the
# discipline was real (20efc55: "FAIL 0, SKIP 0, PASS 10 -- the fixture-staleness
# assertion actually ran"), but "someone remembered" is not a guard.
#
# This gate makes it automatic on exactly the commits that can invalidate the
# cache. Everything else is untouched: zero cost on a docs or test-only commit.
if git diff --cached --name-only \
   | grep -qE '^(R/spm\.R|tests/testthat/fixtures/make-znb-fixtures\.R|data-raw/prepare_znb_data\.R)$'; then
  echo "→ SPM-generation code staged; regenerating the scan to prove the fixture is not stale (~21 s)..." >&2
  if ! MSAMODEL_FULL_TESTS=true Rscript -e \
       'devtools::load_all(quiet = TRUE); testthat::test_file("tests/testthat/test-spm-generate.R", stop_on_failure = TRUE)' \
       >&2 2>&1; then
    blocked=1
    cat >&2 <<'EOF'
✖ Commit blocked: the SPM fixture no longer reproduces from its recipe.

  You changed SPM/ENM generation code. The embedded fixture (znb_spm / znb_wt) is
  a cached result of that code -- it is now STALE, and every test that consumes it
  as input will keep passing against old numbers.

  If the change was INTENDED, regenerate the fixture and stage it:

      Rscript tests/testthat/fixtures/make-znb-fixtures.R

  Then re-run and confirm green before committing. Do NOT bypass this to "fix it
  later": a stale fixture is invisible in every other test.
EOF
  fi
fi

exit $blocked
