#!/bin/sh
# Guard: vignettes use the .Rmd.orig precompute pattern. Each shipped
# vignettes/<name>.Rmd is PRE-RENDERED from vignettes/<name>.Rmd.orig and must be
# re-knit whenever the source changes, or it silently goes stale.
#
# This hook blocks a commit that stages any <name>.Rmd.orig source WITHOUT also
# staging its re-rendered <name>.Rmd. It does NOT recompute or diff content (that
# would fight intentional edits); it only checks that a re-knit was staged
# alongside the edit. Covers every vignettes/*.Rmd.orig (intro, dr2n-analysis,
# and any future ones).
#
# Enabled via:  git config core.hooksPath .githooks
# Bypass once (e.g. an unrelated comment-only edit to an .orig):
#   git commit --no-verify

staged() {
  git diff --cached --name-only | grep -qx "$1"
}

blocked=0

# --- Gate 1: vignettes/ require explicit user HTML approval ------------------
# The user previews dev/preview/<name>.html themselves and must approve before
# any vignettes/ change is committed. Re-knitting / passing tests / the model
# eyeballing a preview do NOT count. This hook makes that mechanical: a commit
# touching vignettes/ is blocked unless VIGNETTE_APPROVED=1 is set, which the
# user sets (or tells the model to set) ONLY after approving the rendered HTML.
#   Approved commit:   VIGNETTE_APPROVED=1 git commit ...
# (Violated 2026-06-18 — committed re-knit vignettes the user never saw.)
if git diff --cached --name-only | grep -q '^vignettes/'; then
  if [ "$VIGNETTE_APPROVED" != "1" ]; then
    blocked=1
    cat >&2 <<'EOF'
✖ Commit blocked: it touches vignettes/ but no user HTML approval is recorded.

  The user previews the rendered HTML (dev/preview/<name>.html) and approves it
  BEFORE vignettes/ is committed. Re-knitting, "tests pass", or the model looking
  at a preview do NOT satisfy this.

  Regenerate every affected preview, have the USER open and approve it, then:

      VIGNETTE_APPROVED=1 git commit ...

  Genuine non-vignette-content edit (e.g. fixing this hook)? bypass: git commit --no-verify
EOF
  fi
fi
# --- Gate 2: no new R CMD check suppressions ---------------------------------
# A check finding is information. Silencing one makes check() quiet without
# making anything true, and the quiet is indistinguishable from a clean run.
#
# On 2026-08-07 utils::globalVariables() was found holding 47 names of which only
# 11 corresponded to a real complaint; the rest had accumulated across commits
# titled "fix(check)" and "declare new NSE globals". Nothing was hidden -- the
# commits were honestly named -- but nobody ever asked whether suppressing was
# the right response, and the baseline note count concealed the growth.
#
# This gate blocks a commit that ADDS a suppression construct. It does not care
# about removals. If a suppression is genuinely warranted, the MAINTAINER decides
# and records it by setting the override:
#   SUPPRESSION_APPROVED=1 git commit ...
added_suppressions=$(
  git diff --cached -U0 -- '*.R' '*.Rmd' DESCRIPTION NAMESPACE .Rbuildignore 2>/dev/null \
    | grep '^+' | grep -v '^+++' \
    | grep -nE 'globalVariables|suppressWarnings|suppressMessages|\bna\.rm[[:space:]]*=[[:space:]]*TRUE|@importFrom[[:space:]]+rlang[[:space:]]+\.data' \
    || true
)
if [ -n "$added_suppressions" ] && [ "$SUPPRESSION_APPROVED" != "1" ]; then
  blocked=1
  {
    echo "✖ Commit blocked: it ADDS a construct that can silence a check finding."
    echo
    echo "$added_suppressions" | sed 's/^/    /'
    echo
    cat <<'EOF'
  A check NOTE/WARNING is information about the code. Suppressing it makes
  check() quiet without making anything true -- and a quiet check() is then no
  longer evidence of anything.

  Before committing, answer: is the finding WRONG (the code is correct and the
  checker cannot see it), or is the code worth changing? Say which, out loud, to
  the maintainer. Do not decide alone.

  If the maintainer agrees the suppression is right:

      SUPPRESSION_APPROVED=1 git commit ...

  (Removing a suppression is never blocked. na.rm=TRUE and suppressMessages()
  are matched too: both hide a condition the maintainer may want to see.)
EOF
  } >&2
fi

for orig in $(git diff --cached --name-only | grep '^vignettes/.*\.Rmd\.orig$'); do
  rendered=$(printf '%s' "$orig" | sed 's/\.orig$//')
  name=$(basename "$rendered" .Rmd)
  if ! staged "$rendered"; then
    blocked=1
    cat >&2 <<EOF
✖ Commit blocked: $orig is staged but $rendered is not.

  $orig is the source of truth; $rendered is pre-rendered from it and ships in
  the package. Re-knit and stage the result before committing:

      Rscript dev/knit-vignette.R $name
      git add $rendered vignettes/${name}_files/

  Use the wrapper, NOT a hand-rolled knitr::knit() call: knitr writes figures
  relative to the working directory, so knitting from the package root leaves
  vignettes/${name}_files/ stale while nothing errors (2026-08-06).

  If this .orig change genuinely needs no re-render (e.g. a comment-only edit),
  bypass with:  git commit --no-verify
EOF
  fi
done

exit $blocked
